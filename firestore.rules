rules_version = '2';

// Arihant Jewellers — the site has no server, so these rules ARE the security.
//  • Everyone can read the public catalogue (site/*) and uploaded images (media/*).
//  • Signed-in visitors can only *create* well-formed reviews (held for approval), enquiries and newsletter sign-ups,
//    each paired with throttle/<form>, which enforces a site-wide gap between submissions (rate limit).
//  • Only Google accounts listed in admins/<email> (or the OWNER below) can change anything.
service cloud.firestore {
  match /databases/{database}/documents {

    // The agency account that can always manage admins (bootstrap / recovery).
    function isOwner() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['mpohani75@gmail.com', 'thegrowthbureauu@gmail.com'];
    }
    function isAdmin() {
      return isOwner()
        || (request.auth != null && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())))
        // phone sign-in: Firebase only issues phone_number after the SMS code is verified
        || (request.auth != null && 'phone_number' in request.auth.token
            && exists(/databases/$(database)/documents/admins/$(request.auth.token.phone_number)));
    }
    function str(v, max) { return v is string && v.size() <= max; }
    // Visitors sign in (Google or emailed link) before enquiring or reviewing; the doc records who.
    function signedIn() {
      // email_verified: Google and the emailed link set it; a bare password sign-up with a made-up email does not
      return request.auth != null && request.auth.token.email_verified == true && request.resource.data.uid == request.auth.uid;
    }
    function email(v) { return str(v, 200) && v.matches('[^@ ]+@[^@ ]+[.][^@ ]+'); }
    function fewLinks(v) { return v.split('https?://|www[.]').size() <= 3; }   // at most 2 links
    function recent(t) { return t is int && t > request.time.toMillis() - 300000 && t < request.time.toMillis() + 300000; }
    // The submission must be written in the same batch as throttle/<form> pointing at it.
    function throttled(form, id) {
      return getAfter(/databases/$(database)/documents/throttle/$(form)).data.ref == id
        && getAfter(/databases/$(database)/documents/throttle/$(form)).data.last == request.time;
    }

    // Rate limit (free plan has no server, so it's site-wide): one review per 20 s,
    // one enquiry per 10 s, one sign-up per 5 s. Each browser is also capped at 5/hour (lib/spam.ts).
    match /throttle/{form} {
      allow create, update: if form in ['reviews', 'enquiries', 'subscribers']
        && request.resource.data.keys().hasOnly(['last', 'ref'])
        && request.resource.data.last == request.time
        && str(request.resource.data.ref, 40)
        && existsAfter(/databases/$(database)/documents/$(form)/$(request.resource.data.ref))
        && (resource == null || request.time > resource.data.last
              + duration.value(form == 'reviews' ? 20 : (form == 'enquiries' ? 10 : 5), 's'));
      allow read: if isAdmin();
    }

    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin() && docId in ['catalog', 'content'];
    }

    match /media/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['data', 'name', 'createdAt'])
        && str(request.resource.data.data, 900000) && request.resource.data.data.matches('data:image/.*');
      allow delete: if isAdmin();
    }

    match /reviews/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['productId', 'name', 'email', 'rating', 'title', 'body', 'isApproved', 'createdAt', 'uid'])
        && str(request.resource.data.productId, 64)
        && str(request.resource.data.name, 80) && request.resource.data.name.size() >= 2
        && email(request.resource.data.email)
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && (request.resource.data.title == null || str(request.resource.data.title, 120))
        && str(request.resource.data.body, 3000) && request.resource.data.body.size() >= 10
        && fewLinks(request.resource.data.body)
        && request.resource.data.isApproved == false
        && recent(request.resource.data.createdAt)
        && throttled('reviews', id);
      allow read, create, update, delete: if isAdmin(); // admins move reviews back here when unpublishing
    }

    match /subscribers/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && email(request.resource.data.email)
        && recent(request.resource.data.createdAt)
        && throttled('subscribers', id);
      allow read, delete: if isAdmin();
    }

    // Contact-form and product enquiries (also emailed via Web3Forms). Admins may only change status/notes.
    match /enquiries/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'message', 'product', 'page', 'status', 'notes', 'createdAt', 'uid', 'kind', 'when', 'photo'])
        && (!('kind' in request.resource.data) || request.resource.data.kind in ['visit', 'video', 'exchange', 'scheme', 'custom', 'notify'])
        && (!('photo' in request.resource.data) || (str(request.resource.data.photo, 450000) && request.resource.data.photo.matches('data:image/.*')))
        && (!('when' in request.resource.data) || str(request.resource.data.when, 60))
        && str(request.resource.data.name, 100) && request.resource.data.name.size() >= 2
        && email(request.resource.data.email)
        && str(request.resource.data.phone, 20)
        && str(request.resource.data.message, 4000) && request.resource.data.message.size() >= 10
        && fewLinks(request.resource.data.message)
        && str(request.resource.data.product, 300)
        && str(request.resource.data.page, 500)
        && request.resource.data.status == 'new' && request.resource.data.notes == ''
        && recent(request.resource.data.createdAt)
        && throttled('enquiries', id);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes'])
        && request.resource.data.status in ['new', 'contacted', 'closed']
        && str(request.resource.data.notes, 2000);
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid); // "My enquiries"
      allow delete: if isAdmin();
    }

    // Each signed-in visitor's own wishlist; nobody else (not even admins) reads it.
    match /wishlists/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 100
        && request.resource.data.updatedAt is int;
    }

    match /admins/{email} {
      allow read, write: if isAdmin();
    }
  }
}
